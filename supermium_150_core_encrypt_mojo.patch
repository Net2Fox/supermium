 constexpr wchar_t kProcessorCounter[] =
     L"\\Processor(_Total)\\% Processor Time";
 
+// Supermium: PdhAddEnglishCounter() does not exist on Windows XP, so it is
+// looked up at runtime. The counter paths above are English, and on later
+// versions they must be added with it: PdhAddCounter() expects localized
+// counter names and fails on non-English editions of Windows.
+PDH_STATUS AddEnglishCounter(PDH_HQUERY query,
+                             const wchar_t* counter_path,
+                             PDH_HCOUNTER* counter) {
+  using PdhAddEnglishCounterWFunc =
+      PDH_STATUS(WINAPI*)(PDH_HQUERY, LPCWSTR, DWORD_PTR, PDH_HCOUNTER*);
+  static const auto pdh_add_english_counter =
+      reinterpret_cast<PdhAddEnglishCounterWFunc>(::GetProcAddress(
+          ::GetModuleHandleW(L"pdh.dll"), "PdhAddEnglishCounterW"));
+  if (pdh_add_english_counter) {
+    return pdh_add_english_counter(query, counter_path, 0, counter);
+  }
+  return ::PdhAddCounterW(query, counter_path, 0, counter);
+}
+
