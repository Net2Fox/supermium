+}UACHSpoofType;
+
+std::vector<std::string> split(const std::string& str, const std::string& delimiter) {
+    std::vector<std::string> tokens;
+    size_t start = 0;
+    size_t end = str.find(delimiter);
+
+    while (end != std::string::npos) {
+        tokens.push_back(str.substr(start, end - start));
+        start = end + delimiter.length();
+        end = str.find(delimiter, start);
+    }
+
+    tokens.push_back(str.substr(start, end - start)); // add the last token
+    return tokens;
+}
+
+// Reads the fields of the user-defined "uao" file, which are separated by
+// ";;;". Returns no fields if there is no such file.
+std::vector<std::string> ReadUaoFields() {
+    base::FilePath userdir;
+    if(!base::PathService::Get(chrome::DIR_USER_DATA, &userdir)) {
+        return {}; // Things are seriously wrong if the user data directory cannot be located.
+	}
+    const base::FilePath userpath = userdir.Append(FILE_PATH_LITERAL("uao"));
+    std::string bufstr;
+    if (!base::ReadFileToString(userpath, &bufstr)) {
+        return {};
+    }
+    return split(bufstr, ";;;");
+}
+
+// Function to parse the file
+std::string parseFile(UACHSpoofType SpoofTarget) {
+    // This is consulted for every user agent string, so the file is only read
+    // once, unless "live" customization was requested (as for the layout
+    // constants).
+    std::vector<std::string> fields;
+    if (base::CommandLine::InitializedForCurrentProcess() &&
+        base::CommandLine::ForCurrentProcess()->HasSwitch(
+            "enable-advanced-customization")) {
+        fields = ReadUaoFields();
+    } else {
+        static const base::NoDestructor<std::vector<std::string>> cached_fields(
+            ReadUaoFields());
+        fields = *cached_fields;
+    }
+    if (fields.empty()) {
+       return std::string();
+    }
+    if (fields.size() > SpoofTarget) {
+	   return fields[SpoofTarget];
+    } else {
+       LOG(WARNING) << "UAO file invalid; all fields are not present";
+       return std::string();
+    }
+}
