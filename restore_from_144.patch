+void NewTabButton::OnPaintBackground(gfx::Canvas* canvas) {
+  if (features::IsGlassFrameEnabled() || !UseClassicNewTabButton()) {
+    TabStripControlButton::OnPaintBackground(canvas);
+    return;
+  }
+
+  gfx::ScopedCanvas scoped_canvas(canvas);
+  const SkPath border_path = GetClassicBorderPath(GetCornerRadius());
+  const gfx::Vector2d contents_offset = GetContentsBounds().OffsetFromOrigin();
+
+  BrowserView* const browser_view =
+      browser_ ? BrowserView::GetBrowserViewForBrowser(browser_.get())
+               : nullptr;
+  const BrowserFrameView* const frame_view =
+      browser_view ? browser_view->browser_widget()->GetFrameView() : nullptr;
+  const std::optional<int> bg_id =
+      frame_view ? frame_view->GetCustomBackgroundId(
+                       BrowserFrameActiveState::kUseCurrent)
+                 : std::nullopt;
+  gfx::ImageSkia* const theme_image =
+      (bg_id.has_value() && GetThemeProvider())
+          ? GetThemeProvider()->GetImageSkiaNamed(bg_id.value())
+          : nullptr;
+  if (theme_image) {
+    // The shape of the background texture is defined by a clip path, which
+    // is translated to the contents bounds. The image itself must not be
+    // translated, so that it aligns with the same image painted elsewhere.
+    canvas->ClipPath(
+        border_path.makeOffset(contents_offset.x(), contents_offset.y()),
+        /*do_anti_alias=*/true);
+    ThemedBackground::PaintThemeAlignedImage(canvas, this, browser_view,
+                                             theme_image);
+    return;
+  }
+
+  // Without a theme image, draw a solid color button.
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  canvas->Translate(contents_offset);
+
+  if (GetState() == STATE_HOVERED) {
+    flags.setColor(SkColorSetARGB(0x80, 90, 90, 90));
+  } else {
+    // v60 and rectangular tabs swap the active and inactive frame colors.
+    const bool paint_as_active = GetWidget()->ShouldPaintAsActive();
+    const bool use_active_color =
+        UseClassicShapeWithoutIcon() ? !paint_as_active : paint_as_active;
+    flags.setColor(GetColorProvider()->GetColor(
+        use_active_color ? kColorNewTabButtonBackgroundFrameActive
+                         : kColorNewTabButtonBackgroundFrameInactive));
+  }
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("transparent-tabs")) {
+    flags.setAlphaf(0.7f);
+  }
+  canvas->DrawPath(border_path, flags);
+
+  if (GetLayoutConstant(LayoutConstant::kTabHardBorder)) {
+    flags.setColor(SK_ColorBLACK);
+    flags.setAlphaf(0.7f);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    canvas->DrawPath(border_path, flags);
+  }
+}
