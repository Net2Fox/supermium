+  SkPath GetHighlightPath(const views::View* view) override {
+    const gfx::Vector2d offset = view->GetContentsBounds().OffsetFromOrigin();
+    return GetClassicBorderPath(
+               static_cast<const NewTabButton*>(view)->GetCornerRadius())
+        .makeOffset(offset.x(), offset.y());
+  }
