+// --supermium-tab-options=v60 and =rectangular draw the new tab button as a
+// trapezoid or a rectangle without a '+' glyph.
+bool UseClassicShapeWithoutIcon() {
+  const std::string tab_options =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "supermium-tab-options");
+  return tab_options == "v60" || tab_options == "rectangular";
+}
+
+// The Supermium tab styles and options that change the new tab button get the
+// classic (pre-2023) button that Supermium 144 painted itself.
+bool UseClassicNewTabButton() {
+  const base::CommandLine* const command_line =
+      base::CommandLine::ForCurrentProcess();
+  return UseClassicShapeWithoutIcon() ||
+         command_line->HasSwitch("compact-tab-ui") ||
+         command_line->HasSwitch("transparent-tabs") ||
+         GetLayoutConstant(LayoutConstant::kTabHardBorder);
+}
+
+// Returns the shape of the classic new tab button, relative to the origin of
+// the button's contents bounds. `corner_radius` is the radius of the default
+// (circular) shape.
+SkPath GetClassicBorderPath(int corner_radius) {
+  const std::string tab_options =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "supermium-tab-options");
+  if (tab_options == "v60") {
+    static constexpr SkPoint kPoints[] = {
+        {4.0f, 8.0f}, {24.0f, 8.0f}, {28.0f, 20.0f}, {8.0f, 20.0f}};
+    return SkPath::Polygon(kPoints, /*isClosed=*/true);
+  }
+  if (tab_options == "rectangular") {
+    static constexpr SkPoint kPoints[] = {
+        {8.0f, 8.0f}, {32.0f, 8.0f}, {32.0f, 20.0f}, {8.0f, 20.0f}};
+    return SkPath::Polygon(kPoints, /*isClosed=*/true);
+  }
+
+  float radius = static_cast<float>(corner_radius);
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("compact-tab-ui")) {
+    radius -= 2;
+  }
+  return SkPath::Circle(radius, radius, radius);
+}
