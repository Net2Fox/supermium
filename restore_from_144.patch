+  if (!base::Base64Decode(local_state->GetString(kOsCryptEncryptedKeyPrefName),
+                          &encrypted_key_with_header) ||
+      !base::StartsWith(encrypted_key_with_header, kDPAPIKeyPrefix,
+                        base::CompareCase::SENSITIVE)) {
